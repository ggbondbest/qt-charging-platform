/* 充电用户端平台样式（成员3，候选 token —— 合入前需组长评审）
 *
 * 设计 token（单一事实来源，与 C++ 代码保持一致）：
 *   页面底色   #F4F6F8      卡片     #FFFFFF  边框 #E5E9EF  圆角 16
 *   主色(电动绿) #00B578    按下     #009A66  禁用 #B7E5D2
 *   危险 #FA5151  警告 #FF9F2E  信息 #1989FA
 *   文本主 #1F2937  次 #6B7280  淡 #9CA3AF
 */

/* ---------- 页面容器 ---------- */
QWidget#appRoot {
    background: #F4F6F8;
}

/* ---------- 文字角色 ---------- */
QLabel[role="pageTitle"] {
    font-size: 21px;
    font-weight: 800;
    color: #1F2937;
}
QLabel[role="sectionTitle"] {
    font-size: 15px;
    font-weight: 700;
    color: #1F2937;
}
QLabel[role="subtitle"] {
    font-size: 14px;
    color: #1F2937;
}
QLabel[role="secondary"] {
    font-size: 12px;
    color: #6B7280;
}
QLabel[role="caption"] {
    font-size: 11px;
    color: #9CA3AF;
}
QLabel[role="balance"] {
    font-size: 34px;
    font-weight: 800;
    color: #1F2937;
}
QLabel[role="balanceUnit"] {
    font-size: 16px;
    font-weight: 600;
    color: #6B7280;
}
QLabel[role="amountPositive"] {
    font-size: 15px;
    font-weight: 700;
    color: #00B578;
}
QLabel[role="amountStrong"] {
    font-size: 16px;
    font-weight: 800;
    color: #1F2937;
}
QLabel[role="infoValue"] {
    font-size: 14px;
    font-weight: 600;
    color: #1F2937;
}
QLabel[role="powerValue"] {
    font-size: 34px;
    font-weight: 800;
    color: #00B578;
}
QLabel[role="statValue"] {
    font-size: 20px;
    font-weight: 800;
    color: #1F2937;
}
QLabel[role="hintWarn"] {
    font-size: 12px;
    font-weight: 600;
    color: #D97706;
}
QLabel[role="successCheck"] {
    font-size: 40px;
    font-weight: 800;
    color: #00B578;
}
QLabel#uiAvatar {
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
    background: #00B578;
    border-radius: 32px;
}
/* 个人中心 Hub：较小的头像、余额大圆、订单角标 */
QLabel#uiAvatarHub {
    font-size: 24px;
    font-weight: 800;
    color: #FFFFFF;
    background: #00B578;
    border-radius: 28px;
}
QWidget#uiBalancePanel {
    background: #00B578;
    border-radius: 12px;
}
QLabel#uiBalanceCaption {
    font-size: 12px;
    font-weight: 600;
    color: #D6F5E8;
}
QLabel#balanceLabel {
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
}
QLabel#uiBadge[tone="danger"] {
    background: #FA5151;
}
QLabel#uiBadge[tone="success"] {
    background: #00B578;
}
QLabel#uiBadge[tone="neutral"] {
    background: #9CA3AF;
}
QLabel#uiBadge {
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    border-radius: 9px;
    padding: 0px;
}
QLabel#nicknameLabel {
    font-size: 17px;
    font-weight: 800;
    color: #1F2937;
}
QLabel[role="gridIcon"] {
    font-size: 26px;
    color: #1F2937;
}
QLabel[role="gridCaption"] {
    font-size: 12px;
    color: #6B7280;
}
QLineEdit#uiNicknameEdit {
    font-size: 15px;
    color: #1F2937;
    background: #FFFFFF;
    border: 1px solid #E5E9EF;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #00B578;
}
QLabel[role="noticeGlyph"] {
    color: #9CA3AF;
}
QLabel#uiNoticeTitle {
    color: #1F2937;
}
QLabel#uiNoticeDescription {
    color: #6B7280;
}

/* ---------- 卡片 ---------- */
QFrame#uiCard {
    background: #FFFFFF;
    border: 1px solid #E5E9EF;
    border-radius: 16px;
}

/* ---------- 底部操作条（ActionBar：主操作钉底，白底 + 顶部细分割线） ---------- */
QWidget#uiActionBar {
    background: #FFFFFF;
    border-top: 1px solid #E5E9EF;
}
QLabel#uiActionCaption {
    font-size: 12px;
    color: #6B7280;
}
QWidget#uiActionBar QPushButton#uiActionButton {
    border-radius: 14px;
    padding: 14px 22px;
}

/* ---------- 钱包流水：合并为一张记录卡（行间细线，不再一行一卡） ---------- */
QScrollArea#uiWalletRecords {
    background: #FFFFFF;
    border: 1px solid #E5E9EF;
    border-radius: 16px;
}
QScrollArea#uiWalletRecords > QWidget,
QScrollArea#uiWalletRecords > QWidget > QWidget {
    background: transparent;
}
QFrame#uiRecordRow {
    background: transparent;
    border: none;
}
QFrame#uiRecordSeparator {
    background: #EEF2F6;
    border: none;
}

/* ---------- 个人中心：账号服务行 / 退出登录（贴底弱化为文字行） ---------- */
QPushButton#openReservationsButton {
    background: transparent;
    border: none;
    border-bottom: 1px solid #EEF2F6;
    text-align: left;
    color: #1F2937;
    font-size: 14px;
    font-weight: 600;
    padding: 2px 0px;
}
QPushButton#openReservationsButton:pressed {
    color: #00B578;
}
QPushButton#logoutButton {
    background: transparent;
    border: none;
    color: #FA5151;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#logoutButton:pressed {
    color: #D9363E;
    background: #FDEBEB;
    border-radius: 12px;
}

/* ---------- 按钮 ---------- */
QPushButton#uiActionButton[variant="primary"] {
    background: #00B578;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 700;
}
QPushButton#uiActionButton[variant="primary"]:pressed {
    background: #009A66;
}
QPushButton#uiActionButton[variant="primary"]:disabled {
    background: #B7E5D2;
    color: #F2FBF7;
}

QPushButton#uiActionButton[variant="secondary"] {
    background: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D5DCE4;
    border-radius: 24px;
    padding: 11px 22px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#uiActionButton[variant="secondary"]:pressed {
    background: #EEF2F6;
}
QPushButton#uiActionButton[variant="secondary"]:disabled {
    color: #B7BFC9;
    border-color: #E5E9EF;
}

QPushButton#uiActionButton[variant="danger"] {
    background: #FA5151;
    color: #FFFFFF;
    border: none;
    border-radius: 24px;
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 700;
}
QPushButton#uiActionButton[variant="danger"]:pressed {
    background: #D9363E;
}
QPushButton#uiActionButton[variant="danger"]:disabled {
    background: #F3B9BC;
    color: #FDF3F3;
}

QPushButton#uiActionButton[variant="ghost"] {
    background: transparent;
    color: #1F2937;
    border: none;
    padding: 8px 12px;
    font-size: 16px;
    font-weight: 600;
}
QPushButton#uiActionButton[variant="ghost"]:pressed {
    color: #00B578;
}

QPushButton#uiActionButton[variant="chip"] {
    background: #FFFFFF;
    color: #1F2937;
    border: 1px solid #D5DCE4;
    border-radius: 12px;
    padding: 14px 0px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#uiActionButton[variant="chip"]:checked {
    background: #EAF9F2;
    color: #00A76D;
    border: 1px solid #00B578;
    font-weight: 700;
}
QPushButton#uiActionButton[variant="chip"]:pressed {
    background: #F2F5F8;
}

/* ---------- 状态标签 ---------- */
QLabel#uiStatusTag[role="statusTag"] {
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    background: #EEF2F6;
    color: #6B7280;
}
QLabel#uiStatusTag[tone="success"] {
    background: #E2F7EC;
    color: #089E62;
}
QLabel#uiStatusTag[tone="warning"] {
    background: #FFF4E0;
    color: #D97706;
}
QLabel#uiStatusTag[tone="danger"] {
    background: #FDEBEB;
    color: #DC2626;
}
QLabel#uiStatusTag[tone="info"] {
    background: #E8F3FE;
    color: #1971C2;
}

/* ---------- 输入框 ---------- */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D5DCE4;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 15px;
    color: #1F2937;
    selection-background-color: #00B578;
}
QLineEdit:focus {
    border: 1px solid #00B578;
}
QLineEdit:disabled {
    background: #F2F5F8;
    color: #9CA3AF;
}

/* ---------- 滚动区 ---------- */
QScrollArea#uiRecordsScroll {
    background: transparent;
    border: none;
}
QScrollArea#uiRecordsScroll > QWidget > QWidget {
    background: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0px;
}
QScrollBar::handle:vertical {
    background: #D5DCE4;
    border-radius: 3px;
    min-height: 36px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}

/* ---------- Toast ---------- */
QFrame#uiToast {
    background: #2B3440;
    border-radius: 10px;
}
QFrame#uiToast[tone="success"] {
    background: #089E62;
}
QFrame#uiToast[tone="danger"] {
    background: #D9363E;
}
QFrame#uiToast[tone="warning"] {
    background: #D97706;
}
QLabel#uiToastLabel {
    color: #FFFFFF;
    background: transparent;
}

/* ---------- 加载遮罩 ---------- */
QBusyIndicator {
    color: #00B578;
    background: transparent;
}
