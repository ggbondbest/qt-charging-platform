# AI 运营参谋 —— 凭据模板。复制成 .env(.env 已被 .gitignore 覆盖,key 绝不进仓库)
#
# 【mock 版】什么都不用配:不写 ML_ADVISOR_BACKEND、.env 里没有 key 时,后端自动锁 mock,
#   纯本地离线可跑(答辩断网兜底就是这个)。
#
# 【接 DeepSeek(OpenAI 兼容口)】
ML_ADVISOR_BACKEND=openai
OPENAI_API_KEY=sk-请填你自己的key
OPENAI_BASE_URL=https://api.deepseek.com
ML_ADVISOR_MODEL=deepseek-v4-pro

# 【接 DeepSeek(Anthropic 兼容口)】换这个后端需要 pip install anthropic;上面三行注释掉
# ML_ADVISOR_BACKEND=anthropic
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-请填你自己的key
# ML_ADVISOR_MODEL=deepseek-v4-pro

# 直连官方 Anthropic 同理:ANTHROPIC_API_KEY=sk-ant-... + ML_ADVISOR_MODEL=claude-opus-5
# 每轮 agent 最多调用几轮工具(护栏)
# ML_ADVISOR_MAX_STEPS=6
