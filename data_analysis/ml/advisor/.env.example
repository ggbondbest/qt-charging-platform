# Copy to .env.local in this directory, then enter your own AIPing key.
# Only this dedicated local file is read; process environment takes precedence.
# .env.local is git-ignored. Never commit or put the key in Vue.
ML_ADVISOR_ONLINE_ENABLED=1
ML_ADVISOR_API_KEY=
ML_ADVISOR_BASE_URL=https://aiping.cn/api/v1
ML_ADVISOR_MODEL=DeepSeek-V4.1-Flash
ML_ADVISOR_PROVIDER_LABEL=AIPing
