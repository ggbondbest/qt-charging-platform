# Example only. Set these in your terminal environment; the application does not
# silently read .env files. Use your own isolated operational MySQL database.
CHARGEPILOT_MYSQL_HOST=127.0.0.1
CHARGEPILOT_MYSQL_PORT=3306
CHARGEPILOT_MYSQL_DATABASE=chargepilot_demo
CHARGEPILOT_MYSQL_USER=chargepilot_app
CHARGEPILOT_MYSQL_PASSWORD=replace-with-your-own-password
CHARGEPILOT_ADMIN_TOKEN=replace-with-at-least-16-random-characters
# Optional map routing; no API key is needed for the built-in geographic demo.
TENCENT_MAP_API_KEY=
TENCENT_MAP_SECRET_KEY=
# Optional trusted local paths (never point at untrusted downloaded pickle).
# CHARGEPILOT_MODEL_DIR=data_analysis/outputs/chargepilot
# CHARGEPILOT_LOAD_DIR=data_analysis/outputs/ml_load
