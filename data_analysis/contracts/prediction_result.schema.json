{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:charging-analysis:prediction-result:1.0.0",
  "title": "Future model adapter result, not currently implemented inference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "featureVersion", "modelId", "modelVersion", "unit", "points"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "featureVersion": {"const": "history24-v1"},
    "modelId": {"type": "string", "minLength": 1},
    "modelVersion": {"type": "string", "minLength": 1},
    "unit": {"enum": ["kW", "chargers"]},
    "points": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {"type": "object", "additionalProperties": false, "required": ["timestamp", "value"],
        "properties": {"timestamp": {"type": "string", "format": "date-time"}, "value": {"type": "number", "minimum": 0}}}
    }
  }
}
